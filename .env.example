# API Configuration
OTP_SERVICE_URL=http://localhost:8001
BOOKING_SERVICE_URL=http://localhost:8002
ROUTE_SERVICE_URL=http://localhost:8003
API_TIMEOUT=30

# Model Configuration
USE_CUDA=false
MODEL_PATH=models/intent_model.pth
INTENTS_PATH=data/intents.json

# Workflow Configuration
OTP_TIMEOUT=300
BOOKING_TIMEOUT=600
TRANSFER_TIMEOUT=180
ROUTE_TIMEOUT=60

# Memory Configuration
SQLITE_PATH=checkpoints/conversations.db
CLEANUP_INTERVAL=3600

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/chatbot.log

# Optional: Anthropic API (if using LLM for complex NLP)
ANTHROPIC_API_KEY=your_api_key_here
